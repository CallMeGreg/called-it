{
  "Logging": {
    "LogLevel": {
      "Default": "Information"
    }
  },
  "Database": {
    "Provider": "Sqlite"
  },
  "ConnectionStrings": {
    "Database": "Data Source=called-it.dev.db"
  },
  "Auth": {
    "SigningKey": "dev-only-signing-key-change-me-please-32chars!"
  },
  "Contacts": {
    "Pepper": "dev-pepper-not-for-production"
  },
  "SocialAuth": {
    "UseFake": true
  },
  "Sms": {
    "Provider": "Development"
  },
  "Push": {
    "Provider": "Development"
  },
  "Resolution": {
    "UseStub": true
  },
  "Workers": {
    "ResolverIntervalSeconds": 15,
    "EnableDailySetBuilder": true,
    "EnableResolver": true,
    "EnableWindowClosing": true
  }
}
