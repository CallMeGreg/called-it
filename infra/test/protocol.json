{
  "stateVersion": 2,
  "controllerVersion": "2.3.1.0",
  "signedStackOperation": {
    "apiVersion": "2024-03-01",
    "paths": ["deploymentStackOperationStatus", "deploymentStackOperationStatuses", "deploymentStackOperationResults"],
    "queryParameters": ["t", "c", "s", "h"],
    "maxUrlLength": 16384
  },
  "validationRejection": {
    "statusCode": 400,
    "code": "InvalidDeployment",
    "reason": "rg-stack-location-not-allowed",
    "windowSeconds": 300
  },
  "stackStates": {
    "inFlight": ["creating", "validating", "waiting", "deploying", "canceling", "updatingDenyAssignments"],
    "deleting": ["deletingResources", "deleting"],
    "terminal": ["succeeded", "failed", "canceled"]
  }
}
